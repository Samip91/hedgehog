# ─────────────────────────────────────────────────────────────────────────────
# Hedgehog — environment template. Copy to `.env.local` and fill in.
# Every variable here is parsed + validated by src/config/env.ts at startup
# (fail-fast). Never read process.env directly anywhere else.
# ─────────────────────────────────────────────────────────────────────────────

# Postgres (Neon free tier — pgvector supported). Include ?sslmode=require.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Upstash Redis (REST) — hot catalog + rate limits
UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="xxxx"

# NVIDIA NIM API — one key for chat models + embeddings
NVIDIA_API_KEY="nvapi-xxxx"
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
LLM_PARSE_MODEL="meta/llama-3.1-8b-instruct"
LLM_RERANK_MODEL="meta/llama-3.3-70b-instruct"
EMBEDDING_MODEL="nvidia/nv-embedqa-e5-v5"
# Vector dimension of EMBEDDING_MODEL — must match prisma vector(N). Confirm day 1.
EMBEDDING_DIM="1024"

# Protects /api/cron/sync — sent by Vercel Cron as `Authorization: Bearer <secret>`
CRON_SECRET="change-me-with-a-long-random-string"

# Public app URL (used for absolute links / metadata). Safe to expose.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Rate limits — per-bucket requests-per-window, per client IP (fail-open on
# Redis error). Defaults match docs/features/hardening/spec.md AC 1-9.
RL_HEDGES_SAVE_LIMIT="20"
RL_HEDGES_SAVE_WINDOW="600"
RL_HEDGES_READ_LIMIT="60"
RL_HEDGES_READ_WINDOW="60"
RL_HEDGES_DELETE_LIMIT="30"
RL_HEDGES_DELETE_WINDOW="60"
RL_HEALTH_LIMIT="120"
RL_HEALTH_WINDOW="60"

# Structured JSON logger level (debug|info|warn|error). Gates src/server/log.ts.
LOG_LEVEL="info"
